---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Signature from '../components/Signature.astro';
import Menu from '../components/Menu.astro';
import Place from '../components/Place.astro';
import Visit from '../components/Visit.astro';
import { restaurantSchema, menuSchema } from '../data/schema';

const site = Astro.site!;
const jsonLd = [await restaurantSchema(site), await menuSchema(site)];
---
<Base
  home
  title="Let's Dimsum | Authentic Dim Sum in San Pablo City, Laguna"
  description="Authentic Chinese dim sum in San Rafael, San Pablo City, Laguna. Xiao long bao, hakaw, siomai and soft buns, steamed fresh and served warm."
  jsonLd={jsonLd}
>
  <Hero />
  <Marquee />
  <About />
  <Signature />
  <Menu />
  <Place />
  <Visit />
</Base>
