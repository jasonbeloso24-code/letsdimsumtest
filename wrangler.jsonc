{
  // Cloudflare Workers project for the Astro build (static assets + Keystatic API routes).
  // Astro's adapter fills in "main" and "assets" at build time.
  "name": "lets-dimsum",
  "compatibility_date": "2026-10-06",
  // Keystatic's GitHub API routes use Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
