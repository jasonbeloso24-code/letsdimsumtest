---
// The bun mascot from the storefront sign: green line bun, yellow rays.
interface Props {
  class?: string;
}
const { class: className = 'mascot' } = Astro.props;
---
<svg class={className} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g class="mascot__rays" stroke="var(--color-yellow)" stroke-width="5" stroke-linecap="round">
    <line class="ray" x1="22" y1="19" x2="31" y2="27" />
    <line class="ray" x1="36" y1="11" x2="41" y2="22" />
    <line class="ray" x1="50" y1="7" x2="50" y2="20" />
    <line class="ray" x1="64" y1="11" x2="59" y2="22" />
    <line class="ray" x1="78" y1="19" x2="69" y2="27" />
  </g>
  <g fill="none" stroke="var(--color-green)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M34 33 Q30 42 22 49 Q12 58 14 71 Q17 86 50 88 Q83 86 86 71 Q88 58 78 49 Q70 42 66 33 Q63 37 60 40 Q56 33 53 31 Q50 36 47 31 Q44 33 40 40 Q37 37 34 33 Z" />
    <path d="M30 55 Q37 54 41 59 Q36 61 30 64" />
    <path d="M70 55 Q63 54 59 59 Q64 61 70 64" />
    <path d="M42 70 Q50 77 58 70" />
  </g>
</svg>
