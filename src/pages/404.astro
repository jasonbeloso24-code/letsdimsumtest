---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
---
<Base
  noindex
  title="Page Not Found | Let's Dimsum, San Pablo City, Laguna"
  description="This page isn't on the Let's Dimsum site. Head back to the home page or see the full menu of dim sum, buns, noodle soups and desserts."
>
  <section class="notfound page-top section" aria-labelledby="notfound-title">
    <div class="container notfound__inner">
      <Mascot class="mascot notfound__mascot" />
      <h1 class="section-title" id="notfound-title">This page isn't on the menu</h1>
      <p class="notfound__text">The link may be old or mistyped. Everything we serve is on the home page.</p>
      <div class="notfound__actions">
        <a class="btn btn--primary" href="/">Back to the home page</a>
        <a class="link-quiet" href="/menu/">See the full menu</a>
      </div>
    </div>
  </section>
</Base>
