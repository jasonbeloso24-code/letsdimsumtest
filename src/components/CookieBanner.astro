---
// Only rendered when a GTM container is configured: no trackers, no banner.
// [CLIENT TO CONFIRM] PUBLIC_GTM_ID is set in Cloudflare build variables, never in the repo.
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---
{gtmId && (
  <div class="consent" role="region" aria-label="Cookie consent" data-consent data-gtm-id={gtmId} hidden>
    <p class="consent__text">
      We'd like to use analytics cookies to see how people find and use this site. They stay off unless you accept.
      <a class="link-quiet" href="/cookies/">Read the cookie notice</a>
    </p>
    <div class="consent__actions">
      <button type="button" class="btn btn--quiet" data-consent-choice="denied">Decline</button>
      <button type="button" class="btn btn--primary" data-consent-choice="granted">Accept</button>
    </div>
  </div>
)}
